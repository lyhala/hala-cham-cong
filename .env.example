# Copy file này thành .env khi chạy trên máy. Trên Railway thì điền ở tab "Variables".

# Kết nối database PostgreSQL (Railway tự cấp: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/hala_dev?schema=public"

# Tài khoản Admin đầu tiên — tạo tự động ở lần deploy đầu
ADMIN_EMAIL="email-cua-ban@congty.vn"
ADMIN_NAME="Admin"
# Mật khẩu ban đầu cho Admin (không bắt buộc). Bỏ trống → tự sinh ngẫu nhiên và in ra log lần deploy đầu. Luôn bắt đổi ở lần đăng nhập đầu.
ADMIN_INITIAL_PASSWORD=""
