# Copy file này thành .env khi chạy trên máy. Trên Railway thì điền ở tab "Variables".

# Kết nối database PostgreSQL (Railway tự cấp: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/hala_dev?schema=public"

# Tài khoản Admin đầu tiên — tạo tự động ở lần deploy đầu
ADMIN_EMAIL="email-cua-ban@congty.vn"
ADMIN_NAME="Admin"
# Mật khẩu ban đầu cho Admin (không bắt buộc). Bỏ trống → tự sinh ngẫu nhiên và in ra log lần deploy đầu. Luôn bắt đổi ở lần đăng nhập đầu.
ADMIN_INITIAL_PASSWORD=""

# API Hanet (đăng ký/xóa FaceID): client_id + client_secret, và token ban đầu.
# Token hết hạn thì hệ thống tự refresh và lưu bản mới trong database (src/lib/hanet.ts).
HANET_CLIENT_ID=""
HANET_CLIENT_SECRET=""
HANET_ACCESS_TOKEN=""
HANET_REFRESH_TOKEN=""
# ID địa điểm Hanet chứa camera (lấy bằng hanetGetPlaces() trong src/lib/hanet.ts) — dùng khi đăng ký/xóa FaceID
HANET_PLACE_ID=""
# Không bắt buộc: đổi địa chỉ API Hanet nếu khác mặc định https://partner.hanet.ai
HANET_API_BASE=""

# Webhook Hanet (§3.1): client_secret lấy từ Hanet, dùng xác thực dữ liệu Hanet gửi tới /api/webhooks/hanet
HANET_WEBHOOK_SECRET=""

# Đặt lại mật khẩu Admin khi quên (không bắt buộc). Mỗi giá trị chỉ áp dụng 1 lần. Dùng xong nên xóa.
ADMIN_RESET_PASSWORD=""
